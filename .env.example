APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# AI service connection
AI_SERVICE_URL=http://127.0.0.1:8001

# KorvaTTS is loaded inside this backend only when /api/v1/tts/speech is called.
TTS_MAX_TEXT_LENGTH=1500
KORVA_VOICE=hoang_nam
KORVA_TOTAL_STEPS=16
KORVA_SPEED=1.05
KORVA_CACHE_DIR=data/tts_cache
KORVA_HF_HOME=data/huggingface

# STT configuration
STT_MODEL=small
STT_PREWARM_ENABLED=true
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=vi
STT_BEAM_SIZE=1
STT_DATASTORE_PATH=
STT_UPLOAD_DIR=data/stt_uploads
STT_MAX_UPLOAD_MB=100
STT_MAX_WORKERS=2
STT_JOB_TTL_SECONDS=1800
STT_CLEANUP_AUDIO=true
STT_REMOTE_BASE_URL=
STT_REMOTE_TIMEOUT_SECONDS=180
STT_REMOTE_POLL_INTERVAL_SECONDS=0.25
STT_DATASTORE_CACHE_SECONDS=300

# PostgreSQL / Supabase (never commit real passwords)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?sslmode=require

# Security secrets (generate strong random strings for production)
JWT_SECRET=replace-with-strong-random-64-char-secret
INTERNAL_SERVICE_SECRET=replace-with-shared-internal-service-secret
ALLOW_DEMO_ACCOUNTS=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MIN=20
RATE_LIMIT_API_PER_MIN=120
