APP_ENV=development

# KorvaTTS is loaded inside this backend only when /api/v1/tts/speech is called.
TTS_MAX_TEXT_LENGTH=1500
KORVA_VOICE=hoang_nam
KORVA_TOTAL_STEPS=16
KORVA_SPEED=1.05
KORVA_CACHE_DIR=data/tts_cache
KORVA_HF_HOME=data/huggingface

# STT demo. Use small for a faster first smoke test or turbo for the best pilot quality.
STT_MODEL=turbo
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=vi
STT_BEAM_SIZE=5

# Leave empty to use backend/data/verified_aliases.jsonl.
# You can point this at pbl6_base's full datastore later.
STT_DATASTORE_PATH=
STT_UPLOAD_DIR=data/stt_uploads
STT_MAX_UPLOAD_MB=100

# Optional GPU worker (Colab/ngrok). Keep the frontend pointed at this local
# backend; it proxies audio to the worker and corrects the raw transcript here.
STT_REMOTE_BASE_URL=
STT_REMOTE_TIMEOUT_SECONDS=180
STT_REMOTE_POLL_INTERVAL_SECONDS=0.25
STT_DATASTORE_CACHE_SECONDS=300

# Optional until the other backend modules enable Supabase/authentication.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=local-demo-only-change-me
